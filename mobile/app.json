{
  "expo": {
    "name": "Full Vision",
    "slug": "zeca",
    "scheme": "fullvision",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030712",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "android": {
      "package": "one.fullvision.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#030712",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "one.fullvision.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O Full Vision usa a câmera para fotos da OS e para ler código de barras, serial e placa.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Full Vision registra onde a OS foi feita e mostra sua posição para a equipe."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Full Vision usa a câmera para as fotos da OS.",
          "photosPermission": "O Full Vision usa suas fotos para anexar na OS.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7cfb0983-5a27-4f7a-8227-fe94821744b0"
      }
    },
    "owner": "itt-corp"
  }
}
